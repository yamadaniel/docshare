{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docshare",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/d/*"]
  },
  "durable_objects": { "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "ratelimits": [{ "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docshare",
      "database_id": "0a7741a6-ebc5-4de9-9794-783be99e82ab",
      "migrations_dir": "./migrations"
    }
  ]
}
